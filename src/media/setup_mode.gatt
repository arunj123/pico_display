// File: src/media/setup_mode.gatt
// Configuration Profile: Wi-Fi Setup ONLY. No HID Service.

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "Pico Setup"

// Standard Services
#import <battery_service.gatt>
#import <device_information_service.gatt>

// --- Custom Wi-Fi Setup Service ---
PRIMARY_SERVICE, 0000FF00-0000-1000-8000-00805F9B34FB

// Wi-Fi Credentials Characteristic
// UUID: 0000FF01-0000-1000-8000-00805F9B34FB
// Properties: Write, Dynamic, Encrypted
CHARACTERISTIC, 0000FF01-0000-1000-8000-00805F9B34FB, WRITE | DYNAMIC | ENCRYPTION_KEY_SIZE_16

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,