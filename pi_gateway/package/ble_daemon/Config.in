config BR2_PACKAGE_BLE_DAEMON
    bool "ble_daemon"
    depends on BR2_INSTALL_LIBSTDCPP
    depends on BR2_TOOLCHAIN_HAS_THREADS
    help
      Custom BLE Daemon for Pico provisioning.
      
      Uses Kernel BT stack (BlueZ).

comment "ble_daemon needs a toolchain w/ C++, threads"
    depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
