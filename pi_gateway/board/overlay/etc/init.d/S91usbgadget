#!/bin/sh

GADGET_DIR=/sys/kernel/config/usb_gadget/mygadget
VID="0x1d6b"
PID="0x0104"
SERIAL="fedcba9876543210"
MANUFACTURER="Buildroot"
PRODUCT="PiZero Serial+Storage"
DATA_PART="/dev/mmcblk0p3"

log_msg() {
    # Print to the system console (screen) and kernel log
    echo "[USB-GADGET] $1" > /dev/console
}

start_gadget() {
    log_msg "--- Starting USB Gadget Setup ---"

    # 1. Check Hardware Driver (UDC)
    UDC_NAME=$(ls /sys/class/udc 2>/dev/null | head -n 1)
    if [ -z "$UDC_NAME" ]; then
        log_msg "CRITICAL ERROR: No UDC device found in /sys/class/udc!"
        log_msg "CHECK: 1. 'dtoverlay=dwc2' in config.txt"
        log_msg "CHECK: 2. 'dwc2.dtbo' exists in /overlays on SD card"
        exit 1
    fi
    log_msg "UDC Hardware Found: $UDC_NAME"

    # 2. Mount ConfigFS
    mount -t configfs none /sys/kernel/config
    if [ $? -ne 0 ]; then
        log_msg "ERROR: Could not mount configfs. Is CONFIG_USB_CONFIGFS enabled?"
        exit 1
    fi
    
    # Safety: Ensure data is unmounted (just in case)
    umount /mnt/data 2>/dev/null

    # 3. Create Gadget Structure
    mkdir -p $GADGET_DIR
    cd $GADGET_DIR

    echo $VID > idVendor
    echo $PID > idProduct
    echo 0x0100 > bcdDevice
    echo 0x0200 > bcdUSB

    mkdir -p strings/0x409
    echo $SERIAL > strings/0x409/serialnumber
    echo $MANUFACTURER > strings/0x409/manufacturer
    echo $PRODUCT > strings/0x409/product

    mkdir -p configs/c.1/strings/0x409
    echo "Config 1" > configs/c.1/strings/0x409/configuration
    echo 500 > configs/c.1/MaxPower

    # 4. Serial Function (Console)
    mkdir -p functions/acm.usb0
    ln -s functions/acm.usb0 configs/c.1/
    log_msg "Serial function created."

    # 5. Mass Storage Function (Data Partition)
    mkdir -p functions/mass_storage.usb0
    echo 1 > functions/mass_storage.usb0/stall
    
    # Initialize with EMPTY file -> Safe start
    echo "" > functions/mass_storage.usb0/lun.0/file
    echo 0 > functions/mass_storage.usb0/lun.0/ro
    echo 1 > functions/mass_storage.usb0/lun.0/removable
    
    ln -s functions/mass_storage.usb0 configs/c.1/
    log_msg "Mass Storage function created (Empty)."

    # 6. Enable the Gadget (Trigger UDC)
    echo "$UDC_NAME" > UDC
    log_msg "Gadget Enabled. Checking Host Connection..."
    
    # 7. Smart Switch Logic
    sleep 2
    # Check State
    # We check if the UDC reports 'configured' (Host enumerated us)
    UDC_STATE=$(cat /sys/class/udc/$UDC_NAME/state 2>/dev/null)
    log_msg "UDC State: $UDC_STATE"
    
    if [ "$UDC_STATE" = "configured" ]; then
        log_msg "Host DETECTED. Switching to Mass Storage Mode."
        
        # Unmount local usage
        umount /mnt/data 2>/dev/null
        
        # Remove provisioning flag so S99pico_provisioner knows to skip (if it restarts)
        # Note: S99 might have already started?
        # If S99 started, it's holding the file handle?
        # pico_provisioner opens /mnt/data/wifi.conf only when writing?
        # It opens /tmp/...
        # But we should stop the provisioner if it uses the partition?
        # Actually, pico_provisioner itself doesn't lock the partition unless writing.
        # But for safety, we assume if USB is connected, we give it to USB.
        rm -f /tmp/provisioning_active
        
        if [ -b "$DATA_PART" ]; then
            echo "$DATA_PART" > functions/mass_storage.usb0/lun.0/file
            log_msg "Mass Storage LUN mapped to $DATA_PART"
        fi
    else
        log_msg "No Host or Power Only. Keeping Local Mode."
        # Mass Storage remains empty ("No Media")
        mount /dev/mmcblk0p3 /mnt/data || true
    fi
}

case "$1" in
  start)
    # Just start it. If no PC is connected, it simply waits.
    start_gadget
    ;;
  stop)
    echo "" > $GADGET_DIR/UDC
    ;;
esac