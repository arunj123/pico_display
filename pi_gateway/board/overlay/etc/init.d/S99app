#!/bin/sh

# Paths
DATA_DIR="/mnt/data"
WIFI_CONF="$DATA_DIR/wifi.conf"
APP_SCRIPT="/usr/bin/main.py"

start() {
    echo "Starting IoT Gateway..."

    # 1. Create mount point and mount Data
    mkdir -p $DATA_DIR
    mount /dev/mmcblk0p3 $DATA_DIR

    # 2. Check for WiFi config
    if [ ! -f "$WIFI_CONF" ]; then
        echo "No wifi.conf found. Creating template..."
        mount -o remount,rw $DATA_DIR
        printf "network={\n\tssid=\"YOUR_SSID\"\n\tpsk=\"YOUR_PASS\"\n}\n" > $WIFI_CONF
        mount -o remount,ro $DATA_DIR
        echo "Please edit wifi.conf on the DATA partition."
        exit 1
    fi

    # 3. Start WiFi
    echo "Connecting to WiFi..."
    wpa_supplicant -B -i wlan0 -c $WIFI_CONF

    # 4. Wait for IP address (Max 30 seconds)
    TIMEOUT=0
    while ! ifconfig wlan0 | grep "inet addr" > /dev/null; do
        sleep 1
        TIMEOUT=$((TIMEOUT+1))
        if [ $TIMEOUT -gt 30 ]; then
            echo "WiFi Connection Failed."
            break
        fi
    done

    # 5. Run Python Application
    echo "Starting Python Application..."
    # We run it in background so boot finishes
    python3 $APP_SCRIPT &
}

stop() {
    killall python3
    killall wpa_supplicant
    umount $DATA_DIR
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) stop; start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1
esac